# Copy to .env (ignored by git) for docker-compose.yml. Pick your own value; never reuse a deployed password.
# `dotnet run` uses VoxaContextFactory.DevelopmentConnectionString (password root) unless ConnectionString is set,
# so either use root here or set ConnectionString for the API as well.
VOXA_DEV_DB_PASSWORD=root

# Only for the API container (`docker compose up -d`), which runs in Production mode and requires both.
# The board password for /admin in that container:
VOXA_DEV_ADMIN_PASSWORD=bestuur
# Secret for hashing voting codes; any value works locally, or generate one with: openssl rand -hex 32
VOXA_DEV_CODES_PEPPER=local-development-pepper
