# Server settings for docker-compose-production.yml (production and beta). Copy to .env next to the compose file and
# fill in the empty values. Never commit the filled-in file. See docs/deployment.md.

# The app's host name. Cloudflare serves the PWA on it and sends /api to this server.
APP_HOST=app.example.com

# The image path under ghcr.io: <owner>/<repository> in lower case, for example atelix/my-project.
IMAGE_REPOSITORY=

# latest follows every published release through Watchtower; set a release version (for example 1.4.0) to pin it.
# Beta servers use beta.
APP_VERSION=latest

# Cloudflare API token with DNS edit permission, used by Traefik for its certificate (DNS challenge).
CF_DNS_API_TOKEN=

# Let's Encrypt account email for certificate notices.
EMAIL=

# Token the deploy workflows use to call Watchtower; the GitHub secret WATCHTOWER_TOKEN (production) or
# WATCHTOWER_BETA_TOKEN (beta) must hold the same value. Generate it with: openssl rand -hex 32
WATCHTOWER_HTTP_API_TOKEN=

# Database. Keep these values once the server runs: a different database name starts an empty database.
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=
