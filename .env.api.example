# Settings for the API container (docker-compose-production.yml reads .env.api). Copy to .env.api next to the compose
# file and fill in the empty values. ASP.NET Core maps Section__Key to Section:Key. Never commit the filled-in file.
# See docs/voxa.md for what each setting does.

# Required. The board's shared password for /bestuur. Use a long passphrase.
Admin__Password=

# Required. Secret pepper for hashing voting codes (HMAC-SHA256). Generate it once with: openssl rand -hex 32
# Changing it makes every issued code invalid, so keep it for the lifetime of a meeting.
Codes__Pepper=

# The public address of the app, used for the voting link in the code mails, e.g. https://stemmen.example.org
App__PublicUrl=

# Mail: Outbox (trial: nothing is sent, mails appear under Bestuur > Testmailbox) or Mailgun (real mail).
Mail__Mode=Outbox
# Mail__Mailgun__BaseUrl=https://api.eu.mailgun.net/v3/
# Mail__Mailgun__Domain=
# Mail__Mailgun__ApiKey=
# Optional: send every mail to this one address instead of the members, for a dress rehearsal with Mailgun.
# Mail__RedirectTo=

# Optional: the club's key for the member import API (docs/import-api.md). A member administration or an automation
# such as n8n sends it as "Authorization: Bearer <key>". At least 32 characters; generate with: openssl rand -hex 32
# Import__ApiKey=

# Extra origins that may call the API from a browser, next to https://<APP_HOST>, for example PR previews:
# Cors__AllowedOrigins__1=https://pr-12-voxa-pwa.<account>.workers.dev
