# Optional extra settings for the API container (docker-compose-production.yml reads .env.api when it exists).
# ASP.NET Core maps Section__Key to Section:Key. Keep secrets here, out of the compose file and the repository.

# Extra origins that may call the API from a browser, next to https://<APP_HOST>, for example PR previews:
# Cors__AllowedOrigins__1=https://pr-12-starter-pwa.<account>.workers.dev
