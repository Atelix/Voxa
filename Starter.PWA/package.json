{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . && prettier --check src/",
    "format": "prettier --write src/",
    "generate-api-schema": "pnpm dlx swagger-typescript-api generate -p http://localhost:5143/swagger/v1/swagger.json -o src/logic/ -n api.ts --module-name-index 1"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1",
    "vuetify": "^4.3.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.1",
    "vue-tsc": "3.3.14",
    "wrangler": "^4.166.0"
  }
}
